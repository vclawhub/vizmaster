{
  "name": "vizmaster",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VizMaster: interactive high-school math tutorials in the 3Blue1Brown style — Elucim for 2D animated scenes, Three.js + VectorPlay for 3D.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tools:smoke": "bun run scripts/tools-smoke.ts"
  },
  "keywords": [
    "math",
    "education",
    "elucim",
    "three",
    "vectorplay",
    "visualization"
  ],
  "license": "MIT",
  "dependencies": {
    "@elucim/core": "^0.24.0",
    "katex": "^0.18.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.180.0",
    "vectorplay": "^1.3.3"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.10.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
